using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using Newtonsoft.Json;

namespace Television_Show_Air_Counter
{
    public partial class Shows : Form
    {
        private bool showIsSelected = false;
        private int previousSelectedIndex = -1;
        private bool isReverting = false;

        public Shows()
        {
            InitializeComponent();
            this.FormBorderStyle = FormBorderStyle.FixedSingle;
            this.MaximizeBox = false;
            LoadShows();
        }

        public void LoadShows()
        {
            string showsFile = "shows.json";
            if (File.Exists(showsFile))
            {
                try
                {
                    string json = File.ReadAllText(showsFile);
                    if (!string.IsNullOrWhiteSpace(json))
                    {
                        var shows = JsonConvert.DeserializeObject<List<TVShow>>(json);

                        // Keep track of current selection if any
                        string selectedShowName = TVShowToConfigure.SelectedItem != null 
                            ? ((TVShow)TVShowToConfigure.SelectedItem).Name 
                            : null;

                        TVShowToConfigure.DataSource = null; // reset
                        TVShowToConfigure.DataSource = shows;
                        TVShowToConfigure.DisplayMember = "Name";

                        if (selectedShowName != null)
                        {
                            var showToSelect = shows.FirstOrDefault(s => s.Name == selectedShowName);
                            if (showToSelect != null)
                            {
                                TVShowToConfigure.SelectedItem = showToSelect;
                            }
                        }
                        else
                        {
                            TVShowToConfigure.SelectedIndex = -1;
                        }
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Error loading shows: " + ex.Message);
                }
            }
        }

        private void Shows_FormClosed(object sender, FormClosedEventArgs e)
        {
            if (Application.OpenForms["Main"] != null)
            {
                Application.OpenForms["Main"].Enabled = true;
            }
        }

        private void NewShow_Click(object sender, EventArgs e)
        {
            NewShow newShowForm = new NewShow();
            newShowForm.Show();
            this.Enabled = false;
        }

        private void ShowDayFilter_ItemCheck(object sender, ItemCheckEventArgs e)
        {
            if (isReverting) return;

            // We use BeginInvoke so that the evaluation happens after the CheckState has updated
            this.BeginInvoke((MethodInvoker)delegate
            {
                CheckForUnsavedChanges();
            });
        }

        private void CheckForUnsavedChanges()
        {
            if (TVShowToConfigure.SelectedItem == null)
            {
                Save.Enabled = false;
                return;
            }

            TVShow selectedShow = (TVShow)TVShowToConfigure.SelectedItem;
            bool hasChanges = false;

            for (int i = 0; i < ShowDayFilter.Items.Count; i++)
            {
                string dayName = ShowDayFilter.Items[i].ToString();
                if (Enum.TryParse(dayName, out DayOfWeek day))
                {
                    bool isChecked = ShowDayFilter.GetItemChecked(i);
                    bool originallyChecked = selectedShow.AiringDays.Contains(day);
                    if (isChecked != originallyChecked)
                    {
                        hasChanges = true;
                        break;
                    }
                }
            }

            Save.Enabled = hasChanges;
        }

        private void TVShowToConfigure_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (isReverting) return;

            // Check if there's a previous show with unsaved changes
            if (previousSelectedIndex != -1 && TVShowToConfigure.Items.Count > previousSelectedIndex)
            {
                TVShow previousShow = (TVShow)TVShowToConfigure.Items[previousSelectedIndex];
                bool hasChanges = false;

                // Compare state in ShowDayFilter with previousShow.AiringDays
                for (int i = 0; i < ShowDayFilter.Items.Count; i++)
                {
                    string dayName = ShowDayFilter.Items[i].ToString();
                    if (Enum.TryParse(dayName, out DayOfWeek day))
                    {
                        bool isChecked = ShowDayFilter.GetItemChecked(i);
                        bool originallyChecked = previousShow.AiringDays.Contains(day);
                        if (isChecked != originallyChecked)
                        {
                            hasChanges = true;
                            break;
                        }
                    }
                }

                if (hasChanges)
                {
                    var result = MessageBox.Show($"You have unsaved changes for '{previousShow.Name}'. Do you want to discard them and switch to another show?", 
                                                 "Unsaved Changes", 
                                                 MessageBoxButtons.YesNo, 
                                                 MessageBoxIcon.Warning);

                    if (result == DialogResult.No)
                    {
                        // Revert the selected index to keep current show and keep the checklist state
                        isReverting = true;
                        TVShowToConfigure.SelectedIndex = previousSelectedIndex;
                        isReverting = false;
                        return; 
                    }
                }
            }

            if (TVShowToConfigure.SelectedItem != null)
            {
                showIsSelected = true;
                ShowDayFilter.Enabled = true;

                TVShow selectedShow = (TVShow)TVShowToConfigure.SelectedItem;
                for (int i = 0; i < ShowDayFilter.Items.Count; i++)
                {
                    string dayName = ShowDayFilter.Items[i].ToString();
                    if (Enum.TryParse(dayName, out DayOfWeek day))
                    {
                        ShowDayFilter.SetItemChecked(i, selectedShow.AiringDays.Contains(day));
                    }
                }

                previousSelectedIndex = TVShowToConfigure.SelectedIndex;
                CheckForUnsavedChanges();
            }
            else
            {
                showIsSelected = false;
                ShowDayFilter.Enabled = false;
                previousSelectedIndex = -1;
                Save.Enabled = false;
            }
        }

        private void Save_Click(object sender, EventArgs e)
        {
            if (TVShowToConfigure.SelectedItem != null)
            {
                TVShow selectedShow = (TVShow)TVShowToConfigure.SelectedItem;

                var result = MessageBox.Show($"Are you sure you want to save changes for '{selectedShow.Name}'?", 
                                             "Confirm Save", 
                                             MessageBoxButtons.YesNo, 
                                             MessageBoxIcon.Question);

                if (result == DialogResult.Yes)
                {
                    selectedShow.AiringDays.Clear();
                    foreach (var item in ShowDayFilter.CheckedItems)
                    {
                        if (Enum.TryParse(item.ToString(), out DayOfWeek day))
                        {
                            selectedShow.AiringDays.Add(day);
                        }
                    }

                    if (TVShowToConfigure.DataSource is List<TVShow> shows)
                    {
                        string showsFile = "shows.json";
                        File.WriteAllText(showsFile, JsonConvert.SerializeObject(shows, Formatting.Indented));
                        MessageBox.Show("Configuration saved successfully!", "Saved", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                }
            }
        }
    }
}
